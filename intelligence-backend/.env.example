# Intelligence backend configuration

# API key that the DotGit extension uses to authenticate
INTEL_API_KEY=change-me-to-a-strong-secret

# Admin key for /api/intel/refresh (can be same as INTEL_API_KEY)
ADMIN_API_KEY=change-me-admin-secret

# Anthropic API key for AI-powered extraction and enrichment
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI fallback (optional)
OPENAI_API_KEY=sk-...

# Telegram Bot API token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram channel usernames to monitor (without @)
TELEGRAM_CHANNELS=cvenotify,secharvester,vuldb_feed

# SQLite database path (default: ./dotgit-intel.db)
# DB_PATH=/path/to/dotgit-intel.db

# Server port
PORT=4000
